{
	"name": "@cosmo/cosmo-pd101-plugin-webview",
	"private": true,
	"license": "GPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite",
		"dev:test": "VITE_TEST_HARNESS=1 VITE_DEBUG_PANEL=1 bunx --bun vite",
		"prebuild": "bun --filter @cosmo/cosmo-pd101 build:lib",
		"typecheck": "bunx tsc --noEmit",
		"build": "bun run typecheck && bunx --bun vite build",
		"preview": "vite preview",
		"test": "bunx vitest --project unit --run",
		"test:unit": "bunx vitest --project unit --run",
		"test:unit:watch": "bunx vitest --project unit",
		"test:browser": "bunx vitest --project browser --run",
		"test:all": "bunx vitest --run",
		"test:e2e": "bunx playwright test",
		"test:e2e:ui": "bunx playwright test --ui",
		"test:e2e:debug": "PWDEBUG=1 bunx playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^18.3.29",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/browser": "^5.0.0",
		"@vitest/browser-playwright": "^5.0.0",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/ui": "5.0.0",
		"daisyui": "^5.5.20",
		"happy-dom": "^20.9.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.14",
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"dependencies": {
		"@cosmo/cosmo-pd101": "workspace:*",
		"i18next": "^26.0.6",
		"react-i18next": "^17.0.4",
		"tsdown": "^0.22.2"
	}
}
