{
	"name": "@cosmo/cosmo-pd101",
	"private": true,
	"version": "0.7.1",
	"license": "GPL-3.0-only",
	"type": "module",
	"exports": {
		".": {
			"types": "./lib-dist/index.d.mts",
			"import": "./lib-dist/index.mjs"
		},
		"./i18n": "./src/i18n/locales/en/synth.json"
	},
	"main": "./lib-dist/index.mjs",
	"types": "./lib-dist/index.d.mts",
	"scripts": {
		"build": "bun run build:lib",
		"build:lib": "bun run gen:bindings && bun run gen:factory-presets && tsc --noEmit && bunx tsdown",
		"build:lib:release": "bun run gen:bindings:release && bun run gen:factory-presets && tsc --noEmit && bunx tsdown",
		"build:lib:watch": "bunx tsdown --watch",
		"gen:bindings": "bun ./scripts/gen-bindings.mjs",
		"gen:bindings:release": "COSMO_BINDINGS_RELEASE=1 bun ./scripts/gen-bindings.mjs",
		"check:bindings": "bun ./scripts/gen-bindings.mjs --check",
		"gen:factory-presets": "cargo run -p cosmo-pd101-presets --bin cosmo-pd101-presets --quiet && bunx biome check --write src/lib/synth/factoryCzPresets.ts",
		"test": "bunx vitest --project unit --run",
		"test:unit": "bunx vitest --project unit --run",
		"test:unit:watch": "bunx vitest --project unit",
		"test:browser": "bunx vitest --project browser --run",
		"test:browser:ui": "bunx vitest --project browser --ui",
		"test:all": "bunx vitest --run"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/browser": "^4.1.4",
		"@vitest/browser-playwright": "^4.1.4",
		"@vitest/coverage-v8": "^4.1.4",
		"@vitest/ui": "4.1.11",
		"daisyui": "^5.5.19",
		"fake-indexeddb": "^6.2.5",
		"happy-dom": "^20.9.0",
		"playwright": "^1.49.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"unrun": "0.3.1",
		"vite": "^8.0.3",
		"vitest": "^4.1.4"
	},
	"peerDependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@floating-ui/react": "^0.27.19",
		"@tsdown/css": "^0.23.0",
		"i18next": "^26.0.6",
		"motion": "^12.38.0",
		"react-i18next": "^17.0.4",
		"react-icons": "^5.6.0",
		"react-resizable-panels": "^4.11.2",
		"react-select": "^5.10.2",
		"smol-toml": "^1.6.1",
		"tsdown": "^0.23.0",
		"zustand": "^5.0.12"
	}
}
